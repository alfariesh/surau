{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3004
    },
    {
      "name": "web-workers",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@surau/web", "preview"],
      "port": 3005
