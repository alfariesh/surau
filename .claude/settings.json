{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "vercel@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current *)",
      "Bash(git branch --merged *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(pnpm install *)",
      "Bash(pnpm check *)",
      "Bash(pnpm fix *)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:e2e*)",
      "Bash(pnpm verify *)",
      "Bash(pnpm build *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm why *)",
      "Bash(pnpm ingest *)",
      "Bash(pnpm run check*)",
      "Bash(pnpm run fix*)",
      "Bash(pnpm run test*)",
      "Bash(pnpm run verify*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run dev*)",
      "Bash(pnpm run ingest*)",
      "Bash(pnpm run eval:retrieval*)",
      "Bash(pnpm run db:migrate:local*)",
      "Bash(pnpm run corpus:load:local*)",
      "Bash(pnpm wrangler whoami *)",
      "Bash(pnpm wrangler types *)",
      "Bash(pnpm wrangler dev *)",
      "Bash(vp check *)",
      "Bash(vp test *)",
      "Bash(vp fmt *)",
      "Bash(vp lint *)",
      "Bash(node --test *)",
      "Bash(node -v *)",
      "Bash(npm view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh secret list *)",
      "WebFetch(domain:developers.cloudflare.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:opennext.js.org)",
      "WebFetch(domain:heroui.com)",
      "WebFetch(domain:heroui.pro)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:modelcontextprotocol.io)",
      "WebFetch(domain:ts.sdk.modelcontextprotocol.io)",
      "WebFetch(domain:viteplus.dev)",
      "WebFetch(domain:oxc.rs)",
      "WebFetch(domain:vitest.dev)",
      "WebFetch(domain:pnpm.io)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:sqlite.org)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:playwright.dev)",
      "WebFetch(domain:tanzil.net)",
      "WebFetch(domain:quranenc.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__cloudflare-docs__*",
      "mcp__heroui-pro__*"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git branch -D *)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git add * --force*)",
      "Bash(git add -*f*)",
      "Bash(git add * -f*)",
      "Bash(git merge *)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh secret set *)",
      "Bash(gh api *)",
      "Bash(pnpm deploy*)",
      "Bash(pnpm run deploy*)",
      "Bash(pnpm --filter * deploy*)",
      "Bash(pnpm -F * deploy*)",
      "Bash(pnpm run db:migrate:remote*)",
      "Bash(pnpm db:migrate:remote*)",
      "Bash(pnpm run corpus:promote*)",
      "Bash(pnpm corpus:promote*)",
      "Bash(pnpm run corpus:load:staging*)",
      "Bash(pnpm corpus:load:staging*)",
      "Bash(pnpm run eval:jawab*)",
      "Bash(pnpm eval*)",
      "Bash(pnpm exec wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(pnpm wrangler deploy*)",
      "Bash(pnpm wrangler preview*)",
      "Bash(pnpm wrangler d1 execute *)",
      "Bash(pnpm wrangler d1 migrations apply *)",
      "Bash(pnpm wrangler d1 create *)",
      "Bash(pnpm wrangler r2 *)",
      "Bash(pnpm wrangler secret *)"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(!**/.env.example)",
      "Edit(//Volumes/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(pnpm wrangler d1 delete *)",
      "Bash(pnpm exec wrangler d1 delete *)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
