{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "incremental": true,
    "types": ["node", "react", "react-dom"],
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "src",
    "e2e",
    "playwright.config.ts",
    "next.config.ts",
    "open-next.config.ts",
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
