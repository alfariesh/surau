# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Aset ilustrasi (ADR-054): disematkan lewat iframe sandbox di halaman Surau sendiri.
# Berkas public/ tidak melewati Worker, jadi header di next.config.ts tidak berlaku di sini.
/aset/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Access-Control-Allow-Origin: *
