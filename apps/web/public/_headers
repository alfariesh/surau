# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Aset ilustrasi (ADR-057): disematkan lewat iframe sandbox di halaman Surau sendiri.
# Berkas public/ tidak melewati Worker, jadi header di next.config.ts tidak berlaku di sini.
# no-transform: Cloudflare tidak menyisipkan beacon Web Analytics ke HTML aset (tanpa itu setiap
# iframe tercatat sebagai kunjungan halaman dan beacon gagal CORS dari origin "null").
# CSP sandbox: dibuka langsung pun (bukan lewat iframe), skrip ilustrasi berjalan di origin "null".
/aset/*
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; sandbox allow-scripts

# Mesin ilustrasi bersama (nama berisi hash isi, jadi aman di-cache selamanya).
/aset-mesin/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
