// Worker web Surau (Next.js lewat OpenNext). Keputusan: ADR-002, ADR-003, ADR-017, ADR-026, ADR-034.
// Top-level = PRODUKSI. Blok `previews` = Preview per PR dan TIDAK mewarisi binding produksi:
// setiap binding storage wajib dideklarasikan ulang di sana dengan resource khusus preview.
// `wrangler types` hanya membaca top-level, jadi nama binding di `previews` harus sama persis.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "surau-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild wrangler (keepNames) menyisipkan `__name(fn, "…")` ke kode server. Skrip inline yang
  // dibuat dari `fn.toString()` (next-themes) lalu ikut membawa `__name` ke browser dan gagal
  // (ReferenceError) di halaman yang dirender Worker saat runtime (ISR /kitab, S09, ADR-034).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Pembaca kitab (/kitab/*) terbuka sejak rilis Fase 1 (`rilis-f1`, ADR-037). Tutup darurat:
  // ubah ke "0" lewat PR + deploy, BUKAN dashboard (cache ISR per BUILD_ID; tools/ingest/README.md).
  // `next dev` selalu menampilkannya (ADR-034).
  "vars": {
    "READER_ENABLED": "1",
    // Header Server-Timing /api/search: "1" = sertakan bolak-balik dan baris D1 dibaca (Preview,
    // untuk mengukur). Produksi hanya waktu (ADR-039): rows_read memudahkan memetakan kueri mahal.
    "SEARCH_TIMING_DETAIL": "0",
    // Versi korpus di kunci cache /api/search (S14, ADR-044): SELALU = database_name CORPUS_DB di
    // bawah. Diganti `corpus:promote` bersama binding (dijaga tes tools/ingest/src/corpus.test.ts).
    "SEARCH_CACHE_CORPUS": "surau-corpus-ihya-v5",
  },
  "services": [
    {
      // Self-reference OpenNext (revalidasi/queue ISR); nama harus sama dengan `name`. Dengan queue
      // default (`dummy`) praktis belum dipakai. Dari Preview, binding ini memanggil PRODUKSI (ADR-026).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "surau-web",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "surau-next-cache",
    },
  ],
  // `database_id` WAJIB eksplisit (ARSITEKTUR-TEKNIS §7 aturan 3): binding tanpa ID diprovisikan
  // otomatis saat deploy = DB kosong baru. CORPUS_DB = korpus PRODUKSI blue-green (ADR-005, S10):
  // nama + ID hanya diubah oleh `pnpm run corpus:promote` lewat PR, tidak pernah dengan tangan.
  // `preview_database_id` hanya dipakai lokal (`next dev`, `preview`): miniflare menyimpan D1 lokal
  // per ID, dan ID staging inilah yang dimuat `corpus:load:local` (packages/db/wrangler.jsonc).
  "d1_databases": [
    {
      "binding": "CORPUS_DB",
      "database_name": "surau-corpus-ihya-v5",
      "database_id": "fb0f9660-69ce-412f-9e5f-7c2150cbf901",
      "preview_database_id": "ffc5ce9a-2b5a-4d09-8487-922ff0e67827",
    },
    {
      "binding": "APP_DB",
      "database_name": "surau-app",
      "database_id": "76b6488e-ec17-4e6d-973f-0156091edf8b",
    },
  ],
  // Batas laporan kesalahan (/api/feedback): per klien (kunci = HMAC jaringan IP, ADR-034) dan
  // global (kunci tetap, rilis Fase 1). Batas pencarian (/api/search, S11): per klien dan global.
  // Dihitung per lokasi Cloudflare. `namespace_id` berbeda untuk produksi dan Preview supaya
  // hitungannya tidak bercampur.
  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "FEEDBACK_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SEARCH_GLOBAL_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 300, "period": 60 },
    },
  ],
  // Query string dihapus dari log/trace: pertanyaan pengguna (cari, Jawab) tidak boleh tercatat (P-7).
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  "previews": {
    "vars": {
      "READER_ENABLED": "1",
      "SEARCH_TIMING_DETAIL": "1",
      // Tanpa cache hasil: korpus staging dimuat ulang tanpa versi baru (latensi diukur tanpa cache).
      "SEARCH_CACHE_CORPUS": "",
    },
    "observability": {
      "enabled": true,
      "redact_query_string": true,
      "logs": { "enabled": true, "head_sampling_rate": 1 },
      "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    },
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "surau-web",
      },
    ],
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "surau-next-cache-preview",
      },
    ],
    "d1_databases": [
      {
        "binding": "CORPUS_DB",
        "database_name": "surau-corpus-staging",
        "database_id": "ffc5ce9a-2b5a-4d09-8487-922ff0e67827",
      },
      {
        "binding": "APP_DB",
        "database_name": "surau-app-staging",
        "database_id": "49fd36a5-9e35-4a07-960d-46cfdc5a02db",
      },
    ],
    "ratelimits": [
      {
        "name": "FEEDBACK_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "FEEDBACK_GLOBAL_LIMITER",
        "namespace_id": "2002",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "SEARCH_LIMITER",
        "namespace_id": "2003",
        "simple": { "limit": 60, "period": 60 },
      },
      {
        "name": "SEARCH_GLOBAL_LIMITER",
        "namespace_id": "2004",
        "simple": { "limit": 300, "period": 60 },
      },
    ],
  },
}
