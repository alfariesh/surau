// Worker web Surau (Next.js lewat OpenNext). Keputusan: ADR-002, ADR-003, ADR-017, ADR-026, ADR-034.
// Top-level = PRODUKSI. Blok `previews` = Preview per PR dan TIDAK mewarisi binding produksi:
// setiap binding storage wajib dideklarasikan ulang di sana dengan resource khusus preview.
// `wrangler types` hanya membaca top-level, jadi nama binding di `previews` harus sama persis.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "surau-web",
  // Pembungkus Worker OpenNext (`.open-next/worker.js`): skrip Next ditunda sampai CSS selesai (ADR-122).
  "main": "./worker.ts",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Produksi hanya di https://surau.org (custom domain diatur di dashboard, T-07): workers.dev
  // dimatikan (#64, ADR-062). Docs Cloudflare: domain yang dikelola dashboard = tanpa `routes` +
  // `workers_dev: false`. `preview_urls` eksplisit true: Preview per PR (`pr-N-surau-web…workers.dev`)
  // memakainya. Sisa yang diketahui: setelan yang sama membuat Version URL produksi
  // (`<versi>-surau-web…workers.dev`) tetap hidup di luar WAF zona (ADR-062).
  "workers_dev": false,
  "preview_urls": true,
  // esbuild wrangler (keepNames) menyisipkan `__name(fn, "…")` ke kode server. Skrip inline yang
  // dibuat dari `fn.toString()` (next-themes) lalu ikut membawa `__name` ke browser dan gagal
  // (ReferenceError) di halaman yang dirender Worker saat runtime (ISR /kitab, S09, ADR-034).
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Pembaca kitab (/kitab/*) terbuka sejak rilis Fase 1 (`rilis-f1`, ADR-037). Tutup darurat:
  // ubah ke "0" lewat PR + deploy, BUKAN dashboard (cache ISR per BUILD_ID; tools/ingest/README.md).
  // `next dev` selalu menampilkannya (ADR-034).
  "vars": {
    "REVIEW_ACCESS_ISSUER": "https://misty-moon-bf34.cloudflareaccess.com",
    "REVIEW_ACCESS_AUD": "e123af2da26c3ef34fad7be2ce79480a6232edd72bf2c16d076030563f638bc4",
    // /admin + /api/admin (S20): aplikasi Access `Surau Admin` (T-14), AUD dibaca dari parameter
    // `kid` redirect login Access 2026-10-20. Token aplikasi Tinjau TIDAK berlaku di sini.
    "ADMIN_ACCESS_AUD": "a7f9052cd2ce712ad14811208826bc2f5e4af04de1cc5f261949e79a851d65a4",
    // Kunci akun ustadz peninjau label takhrij (X07, ADR-070), sama dengan apps/api. Kosong =
    // tinjauan tersimpan tetapi belum dipakai (Jawab, tanda kelemahan /api/kutipan).
    "TAKHRIJ_USTADZ_KEYS": "",
    // Editor terjemahan terdaftar (X08, ADR-081): array JSON {key, name, prefix?, suffix?, ustadz,
    // mcp_name, also?}. key = kunci akun Access (hash issuer+subjek, tampil di /tinjau/terjemahan),
    // BUKAN email; nama + gelar tampil publik di label terjemahan atas keputusan pemilik. Hanya akun
    // di sini yang bisa menyimpan koreksi. Menambah orang = PR + ADR (pola ADR-070).
    "TRANSLATION_EDITORS": "[]",
    "READER_ENABLED": "1",
    // Header Server-Timing /api/search: "1" = sertakan bolak-balik dan baris D1 dibaca (Preview,
    // untuk mengukur). Produksi hanya waktu (ADR-039): rows_read memudahkan memetakan kueri mahal.
    "SEARCH_TIMING_DETAIL": "0",
    // Versi korpus di kunci cache /api/search (S14, ADR-044): SELALU = database_name CORPUS_DB di
    // bawah. Diganti `corpus:promote` bersama binding (dijaga tes tools/ingest/src/corpus.test.ts).
    "SEARCH_CACHE_CORPUS": "surau-corpus-ihya-v9",
    // Origin sitemap.xml: produksi selalu alamat kanonis, juga bila diminta lewat Version URL (#64).
    "SITEMAP_ORIGIN": "https://surau.org",
    // /api/jawab (S19–S20): MATI di produksi sampai `/rilis 4`. Guard biaya S20 (Turnstile, kuota,
    // ledger) sudah ada di surau-api; lapis kedua `settings.jawab_enabled` di surau-app juga "0".
    "JAWAB_ROUTE_ENABLED": "0",
    // Halaman pratinjau fixture /dev/* tanpa D1 (X16: /dev/intisari untuk e2e). Produksi "0" = 404;
    // Preview "1" (e2e CI berjalan terhadap Preview); `next dev` selalu terbuka.
    "DEV_PAGES": "0",
  },
  "services": [
    {
      // Self-reference OpenNext (revalidasi/queue ISR); nama harus sama dengan `name`. Dengan queue
      // default (`dummy`) praktis belum dipakai. Dari Preview, binding ini memanggil PRODUKSI (ADR-026).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "surau-web",
    },
    {
      // Worker Jawab tanpa route publik (S19, ADR-010): satu-satunya jalan ke pipeline LLM.
      // surau-api wajib ter-deploy sebelum web (deploy.yml: job deploy-api lebih dulu).
      "binding": "API",
      "service": "surau-api",
    },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "surau-next-cache",
    },
  ],
  // `database_id` WAJIB eksplisit (ARSITEKTUR-TEKNIS §7 aturan 3): binding tanpa ID diprovisikan
  // otomatis saat deploy = DB kosong baru. CORPUS_DB = korpus PRODUKSI blue-green (ADR-005, S10):
  // nama + ID hanya diubah oleh `pnpm run corpus:promote` lewat PR, tidak pernah dengan tangan.
  // `preview_database_id` hanya dipakai lokal (`next dev`, `preview`): miniflare menyimpan D1 lokal
  // per ID, dan ID staging inilah yang dimuat `corpus:load:local` (packages/db/wrangler.jsonc).
  "d1_databases": [
    {
      "binding": "CORPUS_DB",
      "database_name": "surau-corpus-ihya-v9",
      "database_id": "faf1049e-7d78-41ff-90f4-73af2060d0ae",
      "preview_database_id": "ffc5ce9a-2b5a-4d09-8487-922ff0e67827",
    },
    {
      "binding": "APP_DB",
      "database_name": "surau-app",
      "database_id": "76b6488e-ec17-4e6d-973f-0156091edf8b",
    },
  ],
  // Batas laporan kesalahan (/api/feedback): per klien (kunci = HMAC jaringan IP, ADR-034) dan
  // global (kunci tetap, rilis Fase 1). Batas pencarian (/api/search, S11): per klien dan global.
  // Dihitung per lokasi Cloudflare. `namespace_id` berbeda untuk produksi dan Preview supaya
  // hitungannya tidak bercampur.
  "ratelimits": [
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "FEEDBACK_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "SEARCH_GLOBAL_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 1200, "period": 60 },
    },
    // Jawab (S19): rem sementara per klien dan global sebelum kuota/ledger S20. Gateway surau-gw
    // juga membatasi 50 request/menit dan US$1/hari (T-14).
    {
      "name": "JAWAB_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "JAWAB_GLOBAL_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 30, "period": 60 },
    },
    // GET /api/jawab (status UI, S20): tanpa biaya LLM, jadi lebih longgar dari POST.
    {
      "name": "JAWAB_STATUS_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "JAWAB_STATUS_GLOBAL_LIMITER",
      "namespace_id": "1008",
      "simple": { "limit": 600, "period": 60 },
    },
    // GET /api/halaman (X04 W6, gulir bersambung): satu halaman cetak per permintaan, dipicu
    // pembaca yang menggulir; per klien dan global seperti /api/search.
    {
      "name": "PAGE_LIMITER",
      "namespace_id": "1009",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "PAGE_GLOBAL_LIMITER",
      "namespace_id": "1010",
      "simple": { "limit": 1200, "period": 60 },
    },
    // POST /api/minat-kitab (ADR-115): suara minat kitab kandidat; per klien dan global.
    {
      "name": "MINAT_LIMITER",
      "namespace_id": "1011",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "MINAT_GLOBAL_LIMITER",
      "namespace_id": "1012",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  // Query string dihapus dari log/trace: pertanyaan pengguna (cari, Jawab) tidak boleh tercatat (P-7).
  // `invocation_logs: false` (S20, ADR-065): log otomatis per permintaan merekam header termasuk IP
  // mentah (`cf-connecting-ip`, `x-real-ip`; diperiksa dengan `wrangler tail --ip self`). Yang
  // tersisa: event JSON buatan kode (tanpa IP) dan traces (negara/kota, ASN, user agent; tanpa IP).
  // Dijaga tes tools/ingest/src/corpus.test.ts.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  "previews": {
    "vars": {
      // Preview tetap gagal tertutup. Login Access baru dikonfigurasi untuk surau.org.
      "REVIEW_ACCESS_ISSUER": "https://misty-moon-bf34.cloudflareaccess.com",
      "REVIEW_ACCESS_AUD": "e123af2da26c3ef34fad7be2ce79480a6232edd72bf2c16d076030563f638bc4",
      // Wildcard Preview `*-surau-web…/admin` anggota aplikasi `Surau Admin` yang sama (T-14).
      "ADMIN_ACCESS_AUD": "a7f9052cd2ce712ad14811208826bc2f5e4af04de1cc5f261949e79a851d65a4",
      "TAKHRIJ_USTADZ_KEYS": "",
      "TRANSLATION_EDITORS": "[]",
      "READER_ENABLED": "1",
      "SEARCH_TIMING_DETAIL": "1",
      // Tanpa cache hasil: korpus staging dimuat ulang tanpa versi baru (latensi diukur tanpa cache).
      "SEARCH_CACHE_CORPUS": "",
      // Kosong = origin dari host permintaan, supaya sitemap Preview menunjuk dirinya sendiri.
      "SITEMAP_ORIGIN": "",
      // Preview: /api/jawab menyala ke surau-api-staging (lapis kedua: jawab_enabled surau-app-staging).
      "JAWAB_ROUTE_ENABLED": "1",
      "DEV_PAGES": "1",
    },
    "observability": {
      "enabled": true,
      "redact_query_string": true,
      "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 1 },
      "traces": { "enabled": true, "head_sampling_rate": 0.1 },
    },
    "services": [
      {
        "binding": "WORKER_SELF_REFERENCE",
        "service": "surau-web",
      },
      {
        // Service binding dari Preview selalu memanggil deployment PRODUKSI Worker tujuan
        // (docs Workers Previews). Karena itu Preview diarahkan ke Worker staging tersendiri
        // (data staging, apps/api env.staging), bukan surau-api produksi (S19).
        "binding": "API",
        "service": "surau-api-staging",
      },
    ],
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "surau-next-cache-preview",
      },
    ],
    "d1_databases": [
      {
        "binding": "CORPUS_DB",
        "database_name": "surau-corpus-staging",
        "database_id": "ffc5ce9a-2b5a-4d09-8487-922ff0e67827",
      },
      {
        "binding": "APP_DB",
        "database_name": "surau-app-staging",
        "database_id": "49fd36a5-9e35-4a07-960d-46cfdc5a02db",
      },
    ],
    "ratelimits": [
      {
        "name": "FEEDBACK_LIMITER",
        "namespace_id": "2001",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "FEEDBACK_GLOBAL_LIMITER",
        "namespace_id": "2002",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "SEARCH_LIMITER",
        "namespace_id": "2003",
        "simple": { "limit": 60, "period": 60 },
      },
      {
        "name": "SEARCH_GLOBAL_LIMITER",
        "namespace_id": "2004",
        "simple": { "limit": 1200, "period": 60 },
      },
      {
        "name": "JAWAB_LIMITER",
        "namespace_id": "2005",
        "simple": { "limit": 5, "period": 60 },
      },
      {
        "name": "JAWAB_GLOBAL_LIMITER",
        "namespace_id": "2006",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "JAWAB_STATUS_LIMITER",
        "namespace_id": "2007",
        "simple": { "limit": 30, "period": 60 },
      },
      {
        "name": "JAWAB_STATUS_GLOBAL_LIMITER",
        "namespace_id": "2008",
        "simple": { "limit": 600, "period": 60 },
      },
      {
        "name": "PAGE_LIMITER",
        "namespace_id": "2009",
        "simple": { "limit": 60, "period": 60 },
      },
      {
        "name": "PAGE_GLOBAL_LIMITER",
        "namespace_id": "2010",
        "simple": { "limit": 1200, "period": 60 },
      },
      {
        "name": "MINAT_LIMITER",
        "namespace_id": "2011",
        "simple": { "limit": 10, "period": 60 },
      },
      {
        "name": "MINAT_GLOBAL_LIMITER",
        "namespace_id": "2012",
        "simple": { "limit": 120, "period": 60 },
      },
    ],
  },
}
