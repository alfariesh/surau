{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Paket ini dijalankan langsung oleh Node lewat type stripping (tools/ingest), jadi hanya
    // sintaks TS yang bisa dihapus begitu saja yang diizinkan (tanpa enum, namespace, parameter property).
    "erasableSyntaxOnly": true,
    // Tanpa @types/node: paket harus jalan di Worker dan browser juga, jadi API Node tidak boleh lolos typecheck.
    "types": []
  },
  "include": ["src", "test"]
}
