// Binding D1 untuk alat audio (X17). Worker ini tidak pernah di-deploy: `name` hanya syarat wrangler.
// CORPUS = surau-corpus-staging (sama dengan tools/eval): skrip audio dibangun dari Intisari di korpus
// yang dimuat ke staging (pilot X15b, lalu build penuh X15c), lewat getPlatformProxy remoteBindings.
// Alat ini hanya membaca (SELECT), kecuali `pnpm audio staging --confirm` yang mengganti tabel
// `audio_track` staging (X17d); tidak pernah menyentuh korpus produksi.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "surau-audio",
  "compatibility_date": "2026-10-14",
  "d1_databases": [
    {
      "binding": "CORPUS",
      "database_name": "surau-corpus-staging",
      "database_id": "ffc5ce9a-2b5a-4d09-8487-922ff0e67827",
      "preview_database_id": "ffc5ce9a-2b5a-4d09-8487-922ff0e67827",
      "remote": true,
    },
  ],
}
