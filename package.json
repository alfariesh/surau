{
  "name": "surau",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @surau/web dev",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test --coverage && node tools/ingest/scripts/smoke-text.ts",
    "test:e2e": "pnpm --filter @surau/web test:e2e",
    "build": "vp run -r build",
    "verify": "pnpm check && pnpm test && pnpm build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24.11 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
